# Start SafeNet SACSrv when SafeNet eToken 5110 (0529:0620) is plugged in, stop both SACSrv and pcscd when removed
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0529", ATTR{idProduct}=="0620", TAG+="systemd", ENV{SYSTEMD_WANTS}="safenetauthenticationclient.service"
ACTION=="remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{PRODUCT}=="529/620/*", RUN+="/usr/bin/systemctl stop --no-block safenetauthenticationclient.service pcscd.service"
